rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só os e-mails abaixo (com login) leem e escrevem. Troque pelos e-mails reais no console do Firebase.
    function permitido() {
      return request.auth != null
        && request.auth.token.email in [
          'EMAIL_1@exemplo.com',
          'EMAIL_2@exemplo.com'
        ];
    }
    match /tasks/{id} {
      allow read, write: if permitido();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
