# Copie para .env (local) e cadastre as mesmas chaves no Vercel (Project Settings > Environment Variables).
# Estas chaves da Web App do Firebase identificam o projeto, não são segredo.
# O acesso é protegido pelo login e pelas regras do Firestore (firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
